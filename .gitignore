# -------------------------------------------------------------------------
# R / RStudio
# -------------------------------------------------------------------------
# History files
.Rhistory
.Rapp.history

# Session data and workspaces
.RData
.RDataTmp
.RData*

# RStudio project configuration and state
.Rproj.user/

# Environment files and credentials
.Renviron
.Rprofile.site
.env
*.env

# knitr / R Markdown / Quarto caches and outputs
/*_cache/
/cache/
*.knit.md
*.utf8.md

# Package build artifacts (if applicable)
*.tar.gz
*.Rcheck/

# -------------------------------------------------------------------------
# Large Data Files (>100MB GitHub limit)
# -------------------------------------------------------------------------
# GitHub rejects files larger than 100 MB.
# 'data/Reviews.csv' is ~300 MB and will cause push failures unless tracked by Git LFS.
data/Reviews.csv

# Optional: Uncomment the following line if you want to keep all raw datasets out of git:
# data/*.csv

